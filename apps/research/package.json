{
  "name": "@spectre/research",
  "version": "1.0.1",
  "description": "Spectre AI Research Platform - Netflix-style crypto intelligence dashboard",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:safe": "NODE_OPTIONS=--max-old-space-size=4096 vite",
    "setup": "node scripts/setup-apis.mjs",
    "build": "node scripts/check-page-catalog.mjs && node scripts/build-intelligence-content.mjs && vite build && node scripts/check-critical-path.mjs",
    "build:content": "node scripts/build-intelligence-content.mjs",
    "build:prerender": "node scripts/check-page-catalog.mjs && node scripts/build-intelligence-content.mjs && vite build && node scripts/check-critical-path.mjs && node scripts/prerender.mjs",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "remotion:studio": "remotion studio src/remotion/index.jsx",
    "remotion:render": "remotion render src/remotion/index.jsx",
    "remotion:preview": "remotion preview src/remotion/index.jsx"
  },
  "keywords": [
    "research",
    "crypto",
    "react",
    "spectre-ai"
  ],
  "author": "Spectre AI",
  "license": "MIT",
  "dependencies": {
    "@fontsource/instrument-serif": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/playfair-display": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@privy-io/node": "^0.16.0",
    "@privy-io/react-auth": "^3.16.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@remotion/player": "^4.0.419",
    "@solana-program/memo": "^0.11.0",
    "@solana-program/system": "^0.12.0",
    "@solana-program/token": "^0.12.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@upstash/redis": "^1.37.0",
    "@vercel/functions": "^2.0.0",
    "@xyflow/react": "^12.10.2",
    "firebase-admin": "^12.7.0",
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "ethers": "^6.16.0",
    "framer-motion": "^12.34.0",
    "html2canvas": "^1.4.1",
    "i18next": "^25.8.6",
    "lightweight-charts": "^5.1.0",
    "posthog-js": "^1.360.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-grid-layout": "^2.2.2",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.8.1",
    "remotion": "^4.0.419",
    "three": "^0.183.1",
    "vite-plugin-pwa": "^1.2.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.419",
    "@sparticuz/chromium": "^147.0.2",
    "@vitejs/plugin-react": "^4.0.0",
    "puppeteer": "^24.42.0",
    "puppeteer-core": "^24.42.0",
    "vite": "^5.0.0"
  }
}
