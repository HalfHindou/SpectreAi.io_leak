    { "path": "/api/cron/refresh-token-snapshot", "schedule": "*/3 * * * *" },
    { "path": "/api/cron/warm-showcase", "schedule": "*/30 * * * *" },
    { "path": "/api/cron/warm-cache", "schedule": "*/5 * * * *" },
