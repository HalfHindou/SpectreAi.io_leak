    "api/intel-api.js": {
      "includeFiles": "api/_data/intelligence-data.json",
      "maxDuration": 30
    },
    "api/market-api.js": {
      "maxDuration": 30
    },
    "api/social-api.js": {
      "maxDuration": 30
    },
