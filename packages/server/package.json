{
  "name": "@spectre/server",
  "version": "1.0.0",
  "description": "Shared backend server for Spectre AI Platform - Codex/CoinGecko API proxy",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "predev": "lsof -ti tcp:3001 | xargs kill 2>/dev/null; exit 0",
    "dev": "node --watch index.js",
    "predev:lite": "lsof -ti tcp:3001 | xargs kill 2>/dev/null; exit 0",
    "dev:lite": "SPECTRE_DEV_LITE=1 node --watch index.js"
  },
  "dependencies": {
    "@google/genai": "^1.16.0",
    "@vercel/kv": "^2.0.0",
    "canvas": "^3.2.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "msedge-tts": "^2.0.4",
    "node-fetch": "^2.7.0"
  }
}
