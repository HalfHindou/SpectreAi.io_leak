{
  "manifest_version": 3,
  "name": "Spectre Crypto & Stocks Intelligence for X & DexScreener",
  "version": "0.2.0",
  "description": "Real-time crypto scores and market intelligence on X (Twitter) and DexScreener",
  "permissions": [
    "activeTab",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://dexscreener.com/*",
    "https://trade.spectreai.io/*",
    "https://api.coingecko.com/*",
    "https://coin-images.coingecko.com/*",
    "https://assets.coingecko.com/*",
    "https://api.alternative.me/*",
    "https://api.coinmarketcap.com/*",
    "https://api.dexscreener.com/*",
    "https://cdn.dexscreener.com/*",
    "https://www.google.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content/content-script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://dexscreener.com/*"],
      "js": ["content/content-dex.js"],
      "css": ["content/content-dex.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["shared/design-tokens.css", "content/popup.css", "content/sidebar.css", "assets/*", "registry/*"],
      "matches": ["https://x.com/*", "https://twitter.com/*"]
    },
    {
      "resources": ["content/content-dex.css", "assets/*"],
      "matches": ["https://dexscreener.com/*"]
    }
  ]
}
