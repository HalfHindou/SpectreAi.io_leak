{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "VERCEL_GIT_COMMIT_SHA",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "src/**",
        "api/**",
        "public/**",
        "index.html",
        "vite.config.*",
        "package.json"
      ],
      "env": [
        "CODEX_API_KEY",
        "COINGECKO_API_KEY",
        "ANTHROPIC_API_KEY",
        "OPENAI_API_KEY",
        "ZEROX_API_KEY",
        "TEAM_GATE_PASSWORD",
        "AUTH_GATE_SECRET",
        "PRIVY_APP_ID",
        "PRIVY_APP_SECRET",
        "KV_URL",
        "KV_REST_API_URL",
        "KV_REST_API_TOKEN",
        "KV_REST_API_READ_ONLY_TOKEN",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "REDIS_URL",
        "WEBHOOK_CALLBACK_URL",
        "ADMIN_KEY",
        "ADMIN_API_KEY",
        "CRYPTOCOMPARE_API_KEY",
        "CRYPTOPANIC_API_KEY",
        "FINNHUB_API_KEY",
        "CMC_API_KEY",
        "POLYGON_API_KEY",
        "TWITTER_BEARER_TOKEN",
        "ELEVENLABS_API_KEY",
        "ELEVENLABS_VOICE_ID",
        "CODEX_WEBHOOK_SECRET",
        "CODEX_ALLOWED_ORIGINS",
        "CODEX_ORIGIN",
        "BETA_OPEN",
        "RATELIMIT_USE_KV",
        "PRIVY_WEBHOOK_SIGNING_SECRET",
        "FEE_PERCENTAGE",
        "FEE_BPS",
        "COLLECTOR_EVM_ADDRESS",
        "COLLECTOR_SOL_ADDRESS",
        "COLLECTOR_EVM_PRIVATE_KEY",
        "COLLECTOR_SOL_SECRET_KEY",
        "FEE_RECIPIENT_EVM_PRIMARY",
        "FEE_RECIPIENT_EVM_SECONDARY",
        "FEE_RECIPIENT_EVM_TERTIARY",
        "FEE_RECIPIENT_SOL_PRIMARY",
        "FEE_RECIPIENT_SOL_SECONDARY",
        "FEE_RECIPIENT_SOL_TERTIARY",
        "CRON_SECRET",
        "ETHEREUM_RPC_URL",
        "BSC_RPC_URL",
        "POLYGON_RPC_URL",
        "ARBITRUM_RPC_URL",
        "BASE_RPC_URL",
        "HELIUS_RPC_URL",
        "FIREBASE_SERVICE_ACCOUNT_JSON",
        "FIREBASE_PROJECT_ID",
        "VITE_*"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
