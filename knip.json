{
  "workspaces": {
    "apps/research": {
      "entry": ["src/main.jsx", "src/App.jsx", "api/**/*.js"],
      "project": ["src/**/*.{js,jsx,css}", "api/**/*.js"],
      "ignore": ["src/remotion/**", "docs/**", "scripts/**"],
      "ignoreDependencies": ["@remotion/cli", "@remotion/player", "remotion", "msedge-tts"]
    },
    "packages/server": {
      "entry": ["index.js"],
      "project": ["**/*.js"],
      "ignore": ["content/**", "data/**"]
    }
  },
  "ignore": ["spectre-forge/**", ".prompts/**", "desktop/**", "developer-control/**", "apps/war-room/**"]
}
